# microsubsproxy config

# Адрес и порт. Переопределяется env LISTEN.
listen: 127.0.0.1:8090

# Префикс маршрута: запросы вида /<route_prefix>/<subId>.
# Без слешей. Можно сменить, чтобы скрыть стандартный путь.
route_prefix: route_prefix

# Лимит длины subId (защита от мусорных запросов).
max_sub_id_len: 64

# Таймаут на каждый upstream-запрос. Формат time.ParseDuration: 5s, 500ms, 1m, ...
upstream_timeout: 5s

# Какие схемы строк подписки пропускаем в выдачу.
# В v2ray-формате (по умолчанию) все перечисленные схемы проходят как есть.
# В clash-формате (?type=clash или UA matches clash|mihomo|verge|stash|flclash)
# рендерятся только те схемы, для которых есть парсер.
#
# Поддерживаемые сейчас: vless, vmess, trojan, ss, hysteria2 (hy2), tuic,
# wireguard (wg), ssr. Остальное в v2ray проходит pass-through, в clash —
# отбрасывается.
valid_prefixes:
  - vless://
  - vmess://
  - trojan://
  - ss://
  - hysteria2://
  - hy2://
  - tuic://
  - wireguard://
  - wg://
  - ssr://

# Шаблоны URL подписок 3x-ui панелей. %s подставляется из subId.
upstreams:
  - https://<node1_url>/<subscription1_prefix>/%s
  - https://<node2_url>/<subscription2_prefix>/%s

# Статичные конфиги, прибавляются к ответу подписки.
# Полезно для inbound'ов, которых нет в 3x-ui (управляются вручную, через xray
# в другой ноде, и т.п.). URL должен начинаться с одного из valid_prefixes.
#
# sub_ids опционален: пусто = инжект всем; иначе только перечисленным subId.
#
# static_inject:
#   - url: "vless://uuid@addr:port?security=reality&type=xhttp&...#name"
#     name: "RU Bridge"
#     sub_ids: []          # пусто = всем; список subId = только им
#   - url: "vless://..."
#     name: "Backup endpoint"
#     sub_ids: ["abc123def456"]

# Опциональная принудительная правка query-параметров в клиентских URI перед
# выдачей подписки. Применяется только к TLS-подобным ссылкам, где эти параметры
# имеют смысл: VLESS security=tls/reality, Trojan, Hysteria2/Hy2, TUIC.
# VLESS security=none не меняется.
#
# force_query_params:
#   fingerprint: firefox
#   alpn: h2,http/1.1
#   allow_insecure: false

# Опциональный путь к base-YAML для clash-формата (mihomo). Содержимое файла
# мерджится в выдачу: `proxies` всегда наш, остальное (`dns`, `tun`,
# `rule-providers`, `rules`, `proxy-groups`) — из base. Если параметр пуст,
# отдаётся минимальная клэш-конфигурация (PROXY select + MATCH,PROXY rule).
#
# В пользовательской proxy-group ссылка на наши прокси делается через
# `include-all-proxies: true` — фича Mihomo, не нужно перечислять имена.
#
# Пример clash_extra.yaml:
#   dns:
#     enable: true
#     enhanced-mode: fake-ip
#     nameserver: [tls://1.1.1.1, tls://8.8.8.8]
#   tun:
#     enable: true
#     stack: system
#     auto-route: true
#   rule-providers:
#     ads:
#       type: http
#       behavior: domain
#       url: https://example.com/ads.yaml
#       interval: 86400
#   proxy-groups:
#     - name: PROXY
#       type: select
#       include-all-proxies: true
#       proxies: [DIRECT]
#   rules:
#     - RULE-SET,ads,REJECT
#     - MATCH,PROXY
#
# clash_extra: /etc/microsubsproxy/clash_extra.yaml
